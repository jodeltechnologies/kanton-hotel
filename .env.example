# ---------- Supabase (Project settings → API) ----------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Secret. Server only. Never expose it to the browser, never commit it.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---------- Email confirmations (optional) ----------
# Get a key at resend.com. Without it the app still works, it just
# does not send confirmation mail.
RESEND_API_KEY=re_xxxxxxxx
MAIL_FROM=Kanton Hotel <bookings@yourdomain.cm>

# Used in the links inside those emails. On Vercel this is filled in
# automatically, so you only need it for local work.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
